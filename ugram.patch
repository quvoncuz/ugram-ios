+
+/// Suppressed receipts still reach the caller's local cleanup as nil. Never fabricate pts/updates.
+func ugramReadResult<T>(_ request: Signal<T, MTRpcError>) -> Signal<T?, MTRpcError> {
+    return deferred {
+        if UgramPreferences.enabled(.hideRead) { return .single(nil) }
+        return request |> map(Optional.init)
+    }
+}
