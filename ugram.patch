+func ugramMessageTools(context: AccountContext, message: EngineMessage) -> ViewController {
+    let wrapper = LegacyController(presentation: .modal(animateIn: true), theme: context.sharedContext.currentPresentationData.with { $0 }.theme)
+    let controller = UgramMessageToolsController(context: context, message: message)
