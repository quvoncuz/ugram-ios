--- /dev/null
+++ b/submodules/TelegramCore/Sources/UgramMessageFilter.swift
@@ -0,0 +1,28 @@
+import Foundation
+
+public enum UgramMessageFilter {
+    private static let lock = NSLock()
+    private static var previousPattern = ""
+    private static var expression: NSRegularExpression?
+
+    public static func matches(_ text: String) -> Bool {
+        let pattern = UserDefaults.standard.string(forKey: "ugram.filter") ?? ""
+        guard !pattern.isEmpty, pattern.count <= 512 else { return false }
+        lock.lock()
+        if pattern != previousPattern {
+            previousPattern = pattern
+            expression = try? NSRegularExpression(pattern: pattern)
+        }
+        let expression = self.expression
+        lock.unlock()
+        guard let expression = expression else { return false }
+        let bounded = String(text.prefix(16000))
+        let deadline = Date().timeIntervalSinceReferenceDate + 0.005
+        var found = false
+        expression.enumerateMatches(in: bounded, options: [.reportProgress], range: NSRange(bounded.startIndex..., in: bounded)) { result, _, stop in
+            if result != nil { found = true; stop.pointee = true }
+            else if Date().timeIntervalSinceReferenceDate > deadline { stop.pointee = true }
+        }
+        return found
+    }
+}
