@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -euo pipefail
+UGRAM_SOURCE="${1:?Pass the patched Telegram-iOS checkout}"
+UGRAM_TEST_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+UGRAM_TEST_OUT="$(mktemp -d)"
+trap 'rm -rf "$UGRAM_TEST_OUT"' EXIT
+swiftc -warnings-as-errors \
+  "$UGRAM_SOURCE/submodules/TelegramCore/Sources/UgramLocalStore.swift" \
+  "$UGRAM_SOURCE/submodules/TelegramCore/Sources/UgramMessageFilter.swift" \
+  "$UGRAM_TEST_ROOT/main.swift" -o "$UGRAM_TEST_OUT/local-tests"
+"$UGRAM_TEST_OUT/local-tests"
+while IFS= read -r -d '' UGRAM_SWIFT_FILE; do
+  swiftc -frontend -parse "$UGRAM_SWIFT_FILE"
+done < <(find "$UGRAM_SOURCE/submodules/TelegramCore/Sources" "$UGRAM_SOURCE/submodules/TelegramUI/Sources" -name 'Ugram*.swift' -print0)
