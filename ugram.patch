+import Foundation
+import UIKit
+import QuickLook
+import Display
+import LegacyUI
+import TelegramCore
+import AccountContext
+
+func makeUgramController(context: AccountContext, peerId: Int64? = nil, history: Bool = false, modal: Bool = true) -> ViewController {
+    let wrapper = LegacyController(presentation: modal ? .modal(animateIn: true) : .custom, theme: context.sharedContext.currentPresentationData.with { $0 }.theme)
+    let archive = UgramLocalArchive(accountPath: context.account.basePath)
+    let root: UIViewController = history ? UgramHistoryController(archive: archive, peerId: peerId) : UgramSettingsController(archive: archive)
+    if modal {
+        root.navigationItem.leftBarButtonItem = UIBarButtonItem(systemItem: .done, primaryAction: UIAction { [weak wrapper] _ in wrapper?.dismiss() })
+    }
+    wrapper.bind(controller: UINavigationController(rootViewController: root))
+    wrapper.tabBarItem.title = "Ugram"
+    wrapper.tabBarItem.image = UIImage(systemName: "slider.horizontal.3")
+    return wrapper
+}
+
+private func ugramAlert(_ controller: UIViewController, _ text: String) {
+    let alert = UIAlertController(title: "Ugram", message: text, preferredStyle: .alert)
+    alert.addAction(UIAlertAction(title: "OK", style: .default))
+    controller.present(alert, animated: true)
+}
+
+private final class UgramSettingsController: UITableViewController {
+    private let archive: UgramLocalArchive
+    private let groups: [[(String, UgramPreferences.Flag)]] = [
+        [("O‘chirilgan xabarlarni saqlash", .saveDeleted), ("Tahrirlar tarixini saqlash", .saveEdits), ("Yuklangan media nusxasini saqlash", .saveMedia), ("Nusxa sifatida ulashish", .shareCopies), ("Mahalliy kontent cheklovlarini yumshatish", .showRestricted)],
+        [("O‘qilganlikni yubormaslik", .hideRead), ("Hikoya ko‘rilganligini yubormaslik", .hideStories), ("Yozish indikatorini yubormaslik", .hideTyping), ("Onlayn holatini yubormaslik", .hideOnline)]
+    ]
+    init(archive: UgramLocalArchive) { self.archive = archive; super.init(style: .insetGrouped) }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    override func viewDidLoad() { super.viewDidLoad(); title = "Ugram sozlamalari" }
+    override func numberOfSections(in tableView: UITableView) -> Int { return 3 }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section < 2 ? groups[section].count : 3 }
+    override func tableView(_ tableView: UITableView, titleForHeaderInSection section: Int) -> String? { return ["Kontent va tarix", "Ghost mode", "Mahalliy ma’lumotlar"][section] }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        if section == 0 { return "Faqat ushbu ilova qabul qilgan xabarlar va to‘liq yuklangan media saqlanadi. Tarix alohida oynada ko‘rsatiladi. Bir martalik, muddati cheklangan, maxfiy va pullik media saqlanmaydi. Kontent tugmasi server ruxsati yoki yosh tekshiruvini o‘zgartirmaydi." }
+        if section == 1 { return "Sozlamalar shu qurilmadagi barcha hisoblarga tegishli. Boshqa qurilmadagi sessiyalar holat yuborishi mumkin. Onlayn sozlamasi keyingi holat yangilanishida, odatda 30 soniya ichida amal qiladi." }
+        return "Tarix har bir hisob uchun alohida. Limit: 5 000 yozuv va 1 GB media; eng eski yozuvlar avtomatik tozalanadi. iCloud zaxirasiga kiritilmaydi. Filtrni o‘zgartirgach chatni qayta oching."
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.textLabel?.numberOfLines = 0
+        if indexPath.section < 2 {
+            let (name, flag) = groups[indexPath.section][indexPath.row]
+            cell.textLabel?.text = name
+            let toggle = UISwitch()
+            toggle.isOn = UgramPreferences.enabled(flag)
+            toggle.addAction(UIAction { [weak toggle] _ in
+                if let toggle = toggle { UgramPreferences.set(flag, toggle.isOn) }
+            }, for: .valueChanged)
+            cell.accessoryView = toggle
+            cell.selectionStyle = .none
+        } else {
+            cell.textLabel?.text = ["O‘chirilgan xabarlar va tahrirlar tarixi", "Xabar filtri (regex)", "Mahalliy tarixni tozalash"][indexPath.row]
+            cell.accessoryType = .disclosureIndicator
+            if indexPath.row == 2 { cell.textLabel?.textColor = .systemRed }
+        }
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard indexPath.section == 2 else { return }
+        if indexPath.row == 0 {
+            navigationController?.pushViewController(UgramHistoryController(archive: archive, peerId: nil), animated: true)
+        } else if indexPath.row == 1 {
+            let alert = UIAlertController(title: "Regex filtri", message: "Mos keladigan kiruvchi xabarlar chatda yashiriladi. Bo‘sh maydon filtrni o‘chiradi. Xabarlar serverdan o‘chirilmaydi.", preferredStyle: .alert)
+            alert.addTextField { $0.text = UserDefaults.standard.string(forKey: "ugram.filter") }
+            alert.addAction(UIAlertAction(title: "Bekor qilish", style: .cancel))
+            alert.addAction(UIAlertAction(title: "Saqlash", style: .default, handler: { [weak self, weak alert] _ in
+                guard let self = self else { return }
+                let pattern = alert?.textFields?.first?.text ?? ""
+                guard pattern.count <= 512, pattern.isEmpty || (try? NSRegularExpression(pattern: pattern)) != nil else {
+                    ugramAlert(self, "Regex noto‘g‘ri yoki 512 belgidan uzun."); return
+                }
+                UserDefaults.standard.set(pattern, forKey: "ugram.filter")
+            }))
+            present(alert, animated: true)
+        } else {
+            let alert = UIAlertController(title: "Tarix tozalansinmi?", message: "Faqat shu hisobning Ugram mahalliy arxivi o‘chadi. Bu amalni qaytarib bo‘lmaydi.", preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "Bekor qilish", style: .cancel))
+            alert.addAction(UIAlertAction(title: "Tozalash", style: .destructive, handler: { [weak self] _ in
+                guard let self = self else { return }
+                do { try self.archive.clear(); UserDefaults.standard.removeObject(forKey: "ugram.archiveError") }
+                catch { ugramAlert(self, "Tarixni tozalab bo‘lmadi.") }
+            }))
+            present(alert, animated: true)
+        }
+    }
+}
+
+private final class UgramHistoryController: UITableViewController {
+    private let archive: UgramLocalArchive
+    private let peerId: Int64?
+    private var entries: [UgramArchiveEntry] = []
+    init(archive: UgramLocalArchive, peerId: Int64?) { self.archive = archive; self.peerId = peerId; super.init(style: .insetGrouped) }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    override func viewDidLoad() {
+        super.viewDidLoad(); title = "Mahalliy tarix"
+        refreshControl = UIRefreshControl()
+        refreshControl?.addTarget(self, action: #selector(reload), for: .valueChanged)
+        reload()
+    }
+    @objc private func reload() {
+        do { entries = try archive.entries(peerId: peerId) }
+        catch { ugramAlert(self, "Tarixni o‘qib bo‘lmadi.") }
+        refreshControl?.endRefreshing(); tableView.reloadData()
+    }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return entries.count }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        if let error = UserDefaults.standard.string(forKey: "ugram.archiveError") { return error }
+        return entries.isEmpty ? "Hali saqlangan xabar yo‘q. Ugram sozlamalarida tarixni yoqing. Ilovaga oldin kelmagan xabarlarni tiklab bo‘lmaydi." : nil
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let entry = entries[indexPath.row]
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.textLabel?.text = (entry.kind == "deleted" ? "🗑 " : "✎ ") + (entry.text.isEmpty ? "Media" : entry.text)
+        cell.textLabel?.numberOfLines = 3
+        cell.detailTextLabel?.text = entry.chat + " · " + entry.author
+        cell.accessoryType = .disclosureIndicator
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        navigationController?.pushViewController(UgramArchiveDetailController(archive: archive, entry: entries[indexPath.row]), animated: true)
+    }
+}
+
+private final class UgramArchiveDetailController: UITableViewController, QLPreviewControllerDataSource {
+    private let archive: UgramLocalArchive
+    private let entry: UgramArchiveEntry
+    private var previewURL: URL?
+    init(archive: UgramLocalArchive, entry: UgramArchiveEntry) { self.archive = archive; self.entry = entry; super.init(style: .insetGrouped) }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    override func viewDidLoad() { super.viewDidLoad(); title = entry.kind == "deleted" ? "O‘chirilgan xabar" : "Oldingi tahrir" }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return 2 + entry.attachments.count }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.textLabel?.numberOfLines = 0
+        if indexPath.row == 0 { cell.textLabel?.text = entry.text.isEmpty ? "Matnsiz xabar" : entry.text }
+        else if indexPath.row == 1 {
+            cell.textLabel?.text = entry.chat + " · " + entry.author
+            cell.detailTextLabel?.numberOfLines = 0
+            cell.detailTextLabel?.text = Date(timeIntervalSince1970: Double(entry.timestamp)).description + (entry.missingMedia ? "\nMedia nusxasi to‘liq saqlanmagan yoki yuklanmagan." : "")
+        } else { cell.textLabel?.text = URL(fileURLWithPath: entry.attachments[indexPath.row - 2]).lastPathComponent; cell.accessoryType = .disclosureIndicator }
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        if indexPath.row == 0 { UIPasteboard.general.string = entry.text; ugramAlert(self, "Matn nusxalandi."); return }
+        guard indexPath.row >= 2, let url = archive.attachmentURL(entry.attachments[indexPath.row - 2]) else { return }
+        previewURL = url
+        let preview = QLPreviewController(); preview.dataSource = self
+        present(preview, animated: true)
+    }
+    func numberOfPreviewItems(in controller: QLPreviewController) -> Int { return previewURL == nil ? 0 : 1 }
+    func previewController(_ controller: QLPreviewController, previewItemAt index: Int) -> QLPreviewItem { return previewURL! as NSURL }
+}
