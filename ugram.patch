@@ -0,0 +1,73 @@
+import Foundation
+import UIKit
+import TelegramCore
+import SwiftSignalKit
+import AccountContext
+import Display
+import LegacyUI
+import ShareController
+
+func ugramPresentCopy(context: AccountContext, message: EngineMessage, present: @escaping (ViewController) -> Void) {
+    guard ugramCanShareCopy(message) else { return }
+    let media = message.media.first { $0 is TelegramMediaFile || $0 is TelegramMediaImage }
+    guard media != nil else {
+        present(ShareController(context: context, subject: .text(message.text)))
+        return
+    }
+    let wrapper = LegacyController(presentation: .modal(animateIn: true), theme: context.sharedContext.currentPresentationData.with { $0 }.theme)
+    let controller = UgramCopyPreparation(context: context, message: message)
+    controller.finished = { [weak wrapper] subject in
+        wrapper?.dismiss(completion: {
+            present(ShareController(context: context, subject: subject, presetText: message.text, externalShare: false))
+        })
+    }
+    controller.cancel = { [weak wrapper] in wrapper?.dismiss() }
+    wrapper.bind(controller: UINavigationController(rootViewController: controller))
+    present(wrapper)
+}
+
+private final class UgramCopyPreparation: UIViewController {
+    private let context: AccountContext
+    private let message: EngineMessage
+    private let fetch = MetaDisposable()
+    private let status = UILabel()
+    private var timer: Foundation.Timer?
+    private var ended = false
+    var finished: ((ShareControllerSubject) -> Void)?
+    var cancel: (() -> Void)?
+    init(context: AccountContext, message: EngineMessage) {
+        self.context = context; self.message = message
+        super.init(nibName: nil, bundle: nil)
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    deinit { fetch.dispose(); timer?.invalidate() }
+    override func viewDidLoad() {
+        super.viewDidLoad()
+        title = "Nusxa sifatida ulashish"
+        view.backgroundColor = .systemBackground
+        status.text = "Media yuklanmoqda…\nTayyor bo‘lgach qabul qiluvchini tanlaysiz."
+        status.numberOfLines = 0; status.textAlignment = .center
+        status.translatesAutoresizingMaskIntoConstraints = false
+        view.addSubview(status)
+        NSLayoutConstraint.activate([status.centerYAnchor.constraint(equalTo: view.centerYAnchor), status.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: 24), status.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -24)])
+        navigationItem.leftBarButtonItem = UIBarButtonItem(systemItem: .cancel, primaryAction: UIAction { [weak self] _ in
+            self?.stop(); self?.cancel?()
+        })
+    }
+    override func viewDidAppear(_ animated: Bool) {
+        super.viewDidAppear(animated)
+        guard !ended, timer == nil else { return }
+        start()
+    }
+    private func stop() { ended = true; fetch.dispose(); timer?.invalidate() }
+    private func failed() { stop(); status.text = "Faylni yuklab bo‘lmadi. Internetni tekshirib, qayta urinib ko‘ring." }
+    private func start() {
+        timer = Foundation.Timer.scheduledTimer(withTimeInterval: 300, repeats: false) { [weak self] _ in self?.failed() }
+        fetch.set((ugramPrepareMediaCopy(account: context.account, message: message)
+            |> deliverOnMainQueue).start(next: { [weak self] reference in
+                guard let self = self, !self.ended else { return }
+                self.stop()
+                self.finished?(.media(reference, nil))
+            }, error: { [weak self] _ in self?.failed() }))
+    }
+}
diff --git a/ugram-tests/main.swift b/ugram-tests/main.swift
new file mode 100644
--- /dev/null
+++ b/ugram-tests/main.swift
@@ -0,0 +1,77 @@
+import Foundation
+
+var checks = 0
+func check(_ condition: Bool, _ description: String) {
+    precondition(condition, description)
+    checks += 1
+}
+
+let root = FileManager.default.temporaryDirectory.appendingPathComponent("ugram-tests-" + UUID().uuidString)
+try FileManager.default.createDirectory(at: root, withIntermediateDirectories: true)
+defer {
+    try? FileManager.default.removeItem(at: root)
+    for flag in UgramPreferences.Flag.allCases { UserDefaults.standard.removeObject(forKey: "ugram." + flag.rawValue) }
+    UserDefaults.standard.removeObject(forKey: "ugram.filter")
+}
+
+for flag in UgramPreferences.Flag.allCases {
+    UserDefaults.standard.removeObject(forKey: "ugram." + flag.rawValue)
+    check(!UgramPreferences.enabled(flag), "All feature flags must default off")
+    UgramPreferences.set(flag, true)
+    check(UgramPreferences.enabled(flag), "Feature toggle must persist")
+    UgramPreferences.set(flag, false)
+}
+
+let archive = UgramLocalArchive(accountPath: root.appendingPathComponent("account-a").path)
+let other = UgramLocalArchive(accountPath: root.appendingPathComponent("account-b").path)
+check(try archive.entries().isEmpty, "A new account has no history")
+let original = root.appendingPathComponent("cached-video.mp4")
+let payload = Data((0 ..< 2048).map { UInt8($0 % 251) })
+try payload.write(to: original)
+let entry = UgramArchiveEntry(peerId: 100, messageId: 42, timestamp: 1234, kind: "deleted", chat: "Sinov", author: "O‘zbek", text: "Salom 👋", missingMedia: false)
+try archive.append(entry, files: [(original.path, "../../video.mp4")])
+try FileManager.default.removeItem(at: original)
+let stored = try archive.entries()
+check(stored.count == 1, "Deleted message must persist")
+check(stored[0].text == "Salom 👋", "Unicode text must round-trip")
+check(stored[0].attachments.count == 1, "Downloaded attachment must be retained")
+let url = archive.attachmentURL(stored[0].attachments[0])!
+check(try Data(contentsOf: url) == payload, "Media must survive deletion of Telegram's original cache file")
+check(url.path.hasPrefix(archive.directory.path + "/"), "Untrusted filenames must not escape the archive")
+check(archive.attachmentURL("../../cached-video.mp4") == nil, "Traversal must be rejected")
+check(try other.entries().isEmpty, "Accounts must be isolated")
+check(try archive.entries(peerId: 200).isEmpty, "Chat history must be isolated")
+check(try UgramLocalArchive(accountPath: root.appendingPathComponent("account-a").path).entries().count == 1, "History must survive reopening")
+
+let edit = UgramArchiveEntry(peerId: 100, messageId: 42, timestamp: 1234, kind: "edited", chat: "Sinov", author: "O‘zbek", text: "Old text", missingMedia: false)
+try archive.append(edit, files: [(root.appendingPathComponent("missing").path, "missing.jpg")])
+let edited = try archive.entries().first(where: { $0.kind == "edited" })!
+check(edited.missingMedia, "Missing media must be reported, never represented as a recovered file")
+check(edited.attachments.isEmpty, "Missing media must not produce a bogus attachment")
+check(try archive.entries().count == 2, "Edits and deletions must coexist")
+try archive.remove(edited)
+check(try archive.entries().count == 1, "Removing one entry must preserve the rest")
+try archive.clear()
+check(try archive.entries().isEmpty, "Clear must remove the selected account archive")
+
+let limited = UgramLocalArchive(accountPath: root.appendingPathComponent("limited").path, entryLimit: 2, byteLimit: 6)
+let smallFile = root.appendingPathComponent("small.bin")
+try Data([1, 2, 3, 4]).write(to: smallFile)
+try limited.append(entry, files: [(smallFile.path, "a.bin")])
+try limited.append(edit, files: [(smallFile.path, "b.bin")])
+check(try limited.entries().count == 1, "Byte limit must evict old media")
+check(try limited.entries().first?.kind == "edited", "Retention must keep the newest entry")
+try limited.clear()
+for number in 0 ..< 3 {
+    try limited.append(UgramArchiveEntry(peerId: 100, messageId: Int32(number), timestamp: 1, kind: "deleted", chat: "", author: "", text: "\(number)", missingMedia: false), files: [])
+}
+check(try limited.entries().count == 2, "Entry count limit must be enforced")
+
+UserDefaults.standard.set("spam|reklama", forKey: "ugram.filter")
+check(UgramMessageFilter.matches("Bu reklama xabari"), "Filter must match incoming text")
+check(!UgramMessageFilter.matches("Salom 👋"), "Filter must preserve unrelated Unicode text")
+UserDefaults.standard.set("[", forKey: "ugram.filter")
+check(!UgramMessageFilter.matches("hello"), "Invalid persisted patterns fail open")
+UserDefaults.standard.set("", forKey: "ugram.filter")
+check(!UgramMessageFilter.matches("spam"), "Clearing the pattern disables filtering")
+print("Ugram local storage and filter: \(checks) checks passed")
