+import Foundation
+import Postbox
+
+public func ugramCanKeepMessage(_ message: Message) -> Bool {
+    guard message.id.peerId.namespace != Namespaces.Peer.SecretChat,
+          message.id.namespace == Namespaces.Message.Cloud,
+          message.paidContent == nil,
+          message.activeEphemeralReplacementMessage == nil else { return false }
+    // Preserve the native handling of self-destructing and age-gated content.
+    if message.attributes.contains(where: { $0 is AutoremoveTimeoutMessageAttribute || $0 is AutoclearTimeoutMessageAttribute }) { return false }
+    if message.isSensitiveContent(platform: "ios", contentSettings: .default) { return false }
+    return !message.media.contains(where: { $0 is TelegramMediaAction || $0 is TelegramMediaInvoice })
+}
+
+public func ugramArchiveForMediaBox(_ mediaBox: MediaBox) -> UgramLocalArchive {
+    let accountPath = URL(fileURLWithPath: mediaBox.basePath).deletingLastPathComponent().deletingLastPathComponent().path
+    return UgramLocalArchive(accountPath: accountPath)
+}
+
+func ugramArchiveMessage(_ message: Message, mediaBox: MediaBox, kind: String) {
+    guard UgramPreferences.enabled(kind == "deleted" ? .saveDeleted : .saveEdits), ugramCanKeepMessage(message) else { return }
+    var files: [(path: String, name: String)] = []
+    var missingMedia = false
+    for media in message.media {
+        var resource: MediaResource?
+        var name = "media"
+        if let file = media as? TelegramMediaFile {
+            resource = file.resource
+            name = file.fileName ?? (file.isVideo ? "video.mp4" : file.isVoice ? "voice.ogg" : "file")
+        } else if let image = media as? TelegramMediaImage {
+            resource = image.representations.max(by: { $0.dimensions.width * $0.dimensions.height < $1.dimensions.width * $1.dimensions.height })?.resource
+            name = "photo.jpg"
+        }
+        if let resource = resource {
+            if UgramPreferences.enabled(.saveMedia), let path = mediaBox.completedResourcePath(resource) {
+                files.append((path, name))
+            } else {
+                missingMedia = true
+            }
+        }
+    }
+    let entry = UgramArchiveEntry(peerId: message.id.peerId.toInt64(), messageId: message.id.id, timestamp: message.timestamp, kind: kind,
+        chat: message.peers[message.id.peerId]?.debugDisplayTitle ?? "Chat", author: message.author?.debugDisplayTitle ?? "", text: message.text, missingMedia: missingMedia)
+    do {
+        try ugramArchiveForMediaBox(mediaBox).append(entry, files: files)
+    } catch {
+        // Never prevent Telegram's sync or deletion from completing if storage is full.
+        UserDefaults.standard.set("Mahalliy tarixni saqlab bo‘lmadi. Bo‘sh joyni tekshiring.", forKey: "ugram.archiveError")
+    }
+}
