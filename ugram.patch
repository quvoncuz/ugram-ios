diff --git a/submodules/TelegramCore/Sources/UgramLocalStore.swift b/submodules/TelegramCore/Sources/UgramLocalStore.swift
new file mode 100644
--- /dev/null
+++ b/submodules/TelegramCore/Sources/UgramLocalStore.swift
@@ -0,0 +1,167 @@
+import Foundation
+
+/// Device-local preferences. No message content or preference is sent to a server.
+public enum UgramPreferences {
+    public enum Flag: String, CaseIterable {
+        case saveDeleted, saveEdits, saveMedia, shareCopies, hideRead, hideStories, hideTyping, hideOnline, showRestricted
+    }
+    public static func enabled(_ flag: Flag) -> Bool {
+        return UserDefaults.standard.bool(forKey: "ugram." + flag.rawValue)
+    }
+    public static func set(_ flag: Flag, _ value: Bool) {
+        UserDefaults.standard.set(value, forKey: "ugram." + flag.rawValue)
+    }
+}
+
+public struct UgramArchiveEntry: Codable, Equatable {
+    public let id: String
+    public let peerId: Int64
+    public let messageId: Int32
+    public let timestamp: Int32
+    public let capturedAt: Double
+    public let kind: String
+    public let chat: String
+    public let author: String
+    public let text: String
+    public var attachments: [String]
+    public var missingMedia: Bool
+
+    public init(peerId: Int64, messageId: Int32, timestamp: Int32, kind: String, chat: String, author: String, text: String, missingMedia: Bool) {
+        self.id = UUID().uuidString
+        self.peerId = peerId
+        self.messageId = messageId
+        self.timestamp = timestamp
+        self.capturedAt = Date().timeIntervalSince1970
+        self.kind = kind
+        self.chat = chat
+        self.author = author
+        self.text = text
+        self.attachments = []
+        self.missingMedia = missingMedia
+    }
+}
+
+/// A separate archive below the account directory, outside Telegram's disposable media cache.
+/// Completed media is hard-linked before the original is removed; copying is the fallback.
+public final class UgramLocalArchive {
+    private static let lock = NSRecursiveLock()
+    private static var index: [String: [UgramArchiveEntry]] = [:]
+    private static var sizes: [String: Int64] = [:]
+    public let directory: URL
+    public static let maximumEntries = 5000
+    public static let maximumBytes: Int64 = 1024 * 1024 * 1024
+    private let entryLimit: Int
+    private let byteLimit: Int64
+
+    public init(accountPath: String, entryLimit: Int = UgramLocalArchive.maximumEntries, byteLimit: Int64 = UgramLocalArchive.maximumBytes) {
+        self.directory = URL(fileURLWithPath: accountPath, isDirectory: true).appendingPathComponent("ugram-history", isDirectory: true)
+        self.entryLimit = max(1, entryLimit)
+        self.byteLimit = max(1, byteLimit)
+    }
+
+    private func prepare() throws {
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true, attributes: [.posixPermissions: 0o700])
+        var url = directory
+        var values = URLResourceValues()
+        values.isExcludedFromBackup = true
+        try url.setResourceValues(values)
+        #if os(iOS)
+        try FileManager.default.setAttributes([.protectionKey: FileProtectionType.completeUntilFirstUserAuthentication], ofItemAtPath: directory.path)
+        #endif
+    }
+
+    public func entries(peerId: Int64? = nil) throws -> [UgramArchiveEntry] {
+        Self.lock.lock()
+        defer { Self.lock.unlock() }
+        if let entries = Self.index[directory.path] {
+            return entries.filter { peerId == nil || $0.peerId == peerId }
+        }
+        guard FileManager.default.fileExists(atPath: directory.path) else { return [] }
+        let entries = try FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil)
+            .filter { $0.pathExtension == "json" }
+            .compactMap { try? JSONDecoder().decode(UgramArchiveEntry.self, from: Data(contentsOf: $0)) }
+            .sorted { $0.capturedAt > $1.capturedAt }
+        Self.index[directory.path] = entries
+        return entries.filter { peerId == nil || $0.peerId == peerId }
+    }
+
+    public func append(_ entry: UgramArchiveEntry, files: [(path: String, name: String)]) throws {
+        Self.lock.lock()
+        defer { Self.lock.unlock() }
+        try prepare()
+        let previous = try entries()
+        var stored = entry
+        let eventDirectory = directory.appendingPathComponent(entry.id, isDirectory: true)
+        try FileManager.default.createDirectory(at: eventDirectory, withIntermediateDirectories: true)
+        do {
+            for (index, file) in files.enumerated() {
+                let size = (try? FileManager.default.attributesOfItem(atPath: file.path)[.size] as? NSNumber)?.int64Value ?? 0
+                guard size > 0, size <= byteLimit else {
+                    stored.missingMedia = true
+                    continue
+                }
+                let name = "\(index)-" + URL(fileURLWithPath: file.name).lastPathComponent
+                let destination = eventDirectory.appendingPathComponent(name)
+                do {
+                    do {
+                        try FileManager.default.linkItem(atPath: file.path, toPath: destination.path)
+                    } catch {
+                        try FileManager.default.copyItem(atPath: file.path, toPath: destination.path)
+                    }
+                    stored.attachments.append(entry.id + "/" + name)
+                    Self.sizes[destination.path] = size
+                } catch {
+                    stored.missingMedia = true
+                }
+            }
+            let encoded = try JSONEncoder().encode(stored)
+            try encoded.write(to: directory.appendingPathComponent(entry.id + ".json"), options: .atomic)
+            Self.index[directory.path] = ([stored] + previous).sorted { $0.capturedAt > $1.capturedAt }
+        } catch {
+            try? FileManager.default.removeItem(at: eventDirectory)
+            throw error
+        }
+        try trim()
+    }
+
+    public func attachmentURL(_ relativePath: String) -> URL? {
+        let result = directory.appendingPathComponent(relativePath).standardizedFileURL
+        guard result.path.hasPrefix(directory.standardizedFileURL.path + "/"), FileManager.default.fileExists(atPath: result.path) else { return nil }
+        return result
+    }
+
+    private func trim() throws {
+        var used: Int64 = 0
+        for (index, entry) in try entries().enumerated() {
+            for attachment in entry.attachments {
+                if let url = attachmentURL(attachment) {
+                    let size = Self.sizes[url.path] ?? (try? FileManager.default.attributesOfItem(atPath: url.path)[.size] as? NSNumber)?.int64Value ?? 0
+                    Self.sizes[url.path] = size
+                    used += size
+                }
+            }
+            if index >= entryLimit || used > byteLimit {
+                try remove(entry)
+            }
+        }
+    }
+
+    public func remove(_ entry: UgramArchiveEntry) throws {
+        Self.lock.lock()
+        defer { Self.lock.unlock() }
+        guard UUID(uuidString: entry.id) != nil else { return }
+        let assets = directory.appendingPathComponent(entry.id)
+        if FileManager.default.fileExists(atPath: assets.path) { try FileManager.default.removeItem(at: assets) }
+        try FileManager.default.removeItem(at: directory.appendingPathComponent(entry.id + ".json"))
+        Self.index[directory.path]?.removeAll { $0.id == entry.id }
+        for attachment in entry.attachments { Self.sizes.removeValue(forKey: directory.appendingPathComponent(attachment).path) }
+    }
+
+    public func clear() throws {
+        Self.lock.lock()
+        defer { Self.lock.unlock() }
+        if FileManager.default.fileExists(atPath: directory.path) { try FileManager.default.removeItem(at: directory) }
+        Self.index.removeValue(forKey: directory.path)
+        Self.sizes = Self.sizes.filter { !$0.key.hasPrefix(directory.path + "/") }
+    }
+}
