+}
+
+private final class UgramMessageToolsController: UITableViewController {
+    private let context: AccountContext
+    private let message: EngineMessage
+    init(context: AccountContext, message: EngineMessage) { self.context = context; self.message = message; super.init(style: .insetGrouped) }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    override func viewDidLoad() { super.viewDidLoad(); title = "Xabar ma’lumotlari" }
+    override func numberOfSections(in tableView: UITableView) -> Int { return 2 }
+    override func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int { return section == 0 ? 4 : (message.text.isEmpty ? 0 : 2) }
+    override func tableView(_ tableView: UITableView, titleForFooterInSection section: Int) -> String? {
+        return section == 1 ? "Tarjimani tanlasangiz, matn tanlangan xizmat saytiga yuboriladi. Brauzerda tilni almashtirish mumkin. Google: o‘zbekcha; DeepL: inglizcha." : nil
+    }
+    override func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
+        let cell = UITableViewCell(style: .subtitle, reuseIdentifier: nil)
+        cell.textLabel?.numberOfLines = 0
+        if indexPath.section == 0 {
+            switch indexPath.row {
+            case 0: cell.textLabel?.text = "Chat ID: \(message.id.peerId.toInt64()) · Xabar ID: \(message.id.id)"
+            case 1: cell.textLabel?.text = "Muallif: " + (message.author?.debugDisplayTitle ?? "—")
+            case 2: cell.textLabel?.text = Date(timeIntervalSince1970: Double(message.timestamp)).description
+            default:
+                if let file = message.media.compactMap({ $0 as? TelegramMediaFile }).first {
+                    cell.textLabel?.text = "\(file.fileName ?? "Fayl")\n\(file.mimeType) · \(file.size ?? 0) bayt"
+                } else { cell.textLabel?.text = message.text.isEmpty ? "Media xabar" : message.text }
+            }
+        } else { cell.textLabel?.text = indexPath.row == 0 ? "Google’da tarjima (brauzer)" : "DeepL’da tarjima (brauzer)"; cell.accessoryType = .disclosureIndicator }
+        return cell
+    }
+    override func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
+        tableView.deselectRow(at: indexPath, animated: true)
+        guard indexPath.section == 1 else { return }
+        let text = String(message.text.prefix(5000))
+        let url: String
+        if indexPath.row == 0 {
+            var components = URLComponents(string: "https://translate.google.com/")!
+            components.queryItems = [URLQueryItem(name: "sl", value: "auto"), URLQueryItem(name: "tl", value: "uz"), URLQueryItem(name: "text", value: text), URLQueryItem(name: "op", value: "translate")]
+            guard let value = components.url?.absoluteString else { return }
+            url = value
+        } else {
+            guard let escaped = text.addingPercentEncoding(withAllowedCharacters: .alphanumerics) else { return }
+            url = "https://www.deepl.com/en/translator#auto/en/" + escaped
+        }
+        context.sharedContext.applicationBindings.openUrl(url)
+    }
+}
