+import Foundation
+import Postbox
+import SwiftSignalKit
+
+public enum UgramMediaCopyError {
+    case unavailable
+}
+
+public func ugramCanShareCopy(_ message: EngineMessage) -> Bool {
+    let raw = message._asMessage()
+    guard UgramPreferences.enabled(.shareCopies), ugramCanKeepMessage(raw) else { return false }
+    return raw.media.isEmpty || raw.media.contains { $0 is TelegramMediaFile || $0 is TelegramMediaImage || $0 is TelegramMediaWebpage }
+}
+
+// Download using the original message reference, then create a standalone local
+// upload. Resource and database access stay inside TelegramCore.
+public func ugramPrepareMediaCopy(account: Account, message: EngineMessage) -> Signal<AnyMediaReference, UgramMediaCopyError> {
+    guard ugramCanShareCopy(message), let media = message.media.first(where: { $0 is TelegramMediaFile || $0 is TelegramMediaImage }) else { return .fail(.unavailable) }
+    let resource: MediaResource
+    let contentType: MediaResourceUserContentType
+    if let file = media as? TelegramMediaFile {
+        resource = file.resource
+        contentType = MediaResourceUserContentType(file: file)
+    } else if let image = media as? TelegramMediaImage, let representation = image.representations.max(by: { $0.dimensions.width * $0.dimensions.height < $1.dimensions.width * $1.dimensions.height }) {
+        resource = representation.resource
+        contentType = .image
+    } else { return .fail(.unavailable) }
+    let mediaBox = account.postbox.mediaBox
+    let reference = AnyMediaReference.message(message: MessageReference(message._asMessage()), media: media)
+    return Signal { subscriber in
+        let fetch = fetchedMediaResource(mediaBox: mediaBox, userLocation: .peer(message.id.peerId), userContentType: contentType, reference: .media(media: reference, resource: resource)).start(error: { _ in
+            subscriber.putError(.unavailable)
+        })
+        let data = (mediaBox.resourceData(resource) |> filter { $0.complete } |> take(1)).start(next: { value in
+            let size = Int64(value.size)
+            guard size > 0 else { subscriber.putError(.unavailable); return }
+            let local = LocalFileMediaResource(fileId: Int64.random(in: Int64.min ... Int64.max), size: size)
+            mediaBox.copyResourceData(from: resource.id, to: local.id, synchronous: true)
+            guard mediaBox.completedResourcePath(local) != nil else { subscriber.putError(.unavailable); return }
+            let copied: Media
+            if let file = media as? TelegramMediaFile {
+                copied = TelegramMediaFile(fileId: MediaId(namespace: Namespaces.Media.LocalFile, id: local.fileId), partialReference: nil, resource: local, previewRepresentations: [], videoThumbnails: [], immediateThumbnailData: file.immediateThumbnailData, mimeType: file.mimeType, size: size, attributes: file.attributes, alternativeRepresentations: [])
+            } else if let image = media as? TelegramMediaImage, let representation = image.representations.max(by: { $0.dimensions.width * $0.dimensions.height < $1.dimensions.width * $1.dimensions.height }) {
+                copied = TelegramMediaImage(imageId: MediaId(namespace: Namespaces.Media.LocalImage, id: local.fileId), representations: [TelegramMediaImageRepresentation(dimensions: representation.dimensions, resource: local, progressiveSizes: [], immediateThumbnailData: nil)], immediateThumbnailData: image.immediateThumbnailData, reference: nil, partialReference: nil, flags: [])
+            } else { subscriber.putError(.unavailable); return }
+            subscriber.putNext(.standalone(media: copied))
